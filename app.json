{
  "expo": {
    "name": "Jack Track",
    "slug": "jack-track",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/jack-track-logo.png",
    "scheme": "jacktrack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anonymous.jacktrack",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D8F9DD",
        "foregroundImage": "./assets/brand/jack-track-logo.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.jacktrack",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/jack-track-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FBF9",
          "image": "./assets/brand/jack-track-logo.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#071A17",
            "image": "./assets/brand/jack-track-logo.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
