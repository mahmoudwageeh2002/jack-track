{
  "expo": {
    "name": "Jack Track",
    "slug": "jack-track",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "scheme": "jacktrack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./icon.png",
      "bundleIdentifier": "com.anonymous.jacktrack",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D8F9DD",
        "foregroundImage": "./icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.jacktrack",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./icon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-notifications", { "color": "#0B9868", "defaultChannel": "quotes" }],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "JackTrackStreak",
              "displayName": "Workout Streak",
              "description": "Keep your momentum with your current streak and personal best.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Jack Track to access your photos so you can choose a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-png-app-icon",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FBF9",
          "image": "./icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#071A17",
            "image": "./icon.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.anonymous.jacktrack.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.anonymous.jacktrack"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "5a5b72d4-c15c-4819-a8dd-1633a94c296d"
      }
    }
  }
}
